{
  "appId": "dev.clearwater.launcher",
  "productName": "Cleanwater Launcher",
  "directories": {
    "output": "../installer/dist"
  },
  "files": ["src/**"],
  "extraResources": [
    {"from": "../LICENSE", "to": "LICENSE-Clearwater.txt"}
  ],
  "publish": {
    "provider": "github",
    "owner": "primevxie",
    "repo": "Cleanwater"
  },
  "win": {
    "target": "nsis",
    "icon": "src/ui/assets/clearwater.ico",
    "signExecutable": false,
    "artifactName": "Cleanwater-Launcher-Setup-${version}-Windows-x64.exe"
  },
  "linux": {
    "target": "rpm",
    "executableName": "cleanwater-launcher",
    "icon": "src/ui/assets/clearwater.png",
    "category": "Game",
    "artifactName": "cleanwater-launcher-linux-x86_64.rpm"
  },
  "rpm": {
    "maintainer": "Clearwater",
    "depends": [
      "gtk3", "nss", "alsa-lib", "libnotify", "libXScrnSaver", "libXtst", "libuuid",
      "mesa-libgbm", "mesa-dri-drivers", "xdg-utils", "at-spi2-core", "tar", "gzip"
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Cleanwater Launcher",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  }
}
